POST {{baseUrl}}/cart/items
Cookie: {{customerCookie}}
Content-Type: {{contentType}}

{
  "productId": "{{productId}}",
  "quantity": 2
}

### Consulta o carrinho depois da adiÃƒÂ§ÃƒÂ£o.
###
# @name getCart
GET {{baseUrl}}/cart
Cookie: {{customerCookie}}

###

@cartId = {{getCart.response.body.$.id}}
@cartItemId = {{getCart.response.body.$.items[0].id}}

###############################################################################
# CHECKOUT
############################################################################### Fluxo principal: use addressId criado acima ou substitua por seedAddressId.
### Itens, preÃƒÂ§os e totais sÃƒÂ£o obtidos do carrinho e do banco.
###
# @name checkout
POST {{baseUrl}}/checkout
Cookie: {{customerCookie}}
Idempotency-Key: {{idempotencyKey}}
Content-Type: {{contentType}}

{
  "addressId": "{{addressId}}"
}

###

@orderId = {{checkout.response.body.$.id}}
@sellerOrderId = {{checkout.response.body.$.sellerOrders[0].id}}
@orderItemId = {{checkout.response.body.$.sellerOrders[0].items[0].id}}

###
# Em um checkout bem-sucedido a reserva ÃƒÂ© criada; a referÃƒÂªncia fica nula apenas
# se o DTO de um fluxo futuro permitir item sem reserva.
###

@reservationId = {{checkout.response.body.$.sellerOrders[0].items[0].reservation.id}}

### Replay da mesma chave; deve retornar o mesmo DTO sem novo pedido ou reserva.
###
# @name checkoutReplay
POST {{baseUrl}}/checkout
Cookie: {{customerCookie}}
Idempotency-Key: {{idempotencyKey}}
Content-Type: {{contentType}}

{
  "addressId": "{{addressId}}"
}

