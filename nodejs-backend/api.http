### SequÃƒÂªncia opcional de estados; execute cada request na ordem, manualmente.
### SEPARATED -> PROCESSING -> SHIPPED -> COLLECTED -> ARRIVED_AT_CENTER -> DELIVERED.
###
# @name deliveryProcessing
PATCH {{baseUrl}}/deliveries/{{deliveryId}}/status
Cookie: {{sellerCookie}}
Content-Type: {{contentType}}

{
  "status": "PROCESSING",
  "reason": "Processing through api.http"
}

###
# @name deliveryShipped
PATCH {{baseUrl}}/deliveries/{{deliveryId}}/status
Cookie: {{sellerCookie}}
Content-Type: {{contentType}}

{
  "status": "SHIPPED",
  "reason": "Handed to carrier"
}

###
# @name deliveryCollected
PATCH {{baseUrl}}/deliveries/{{deliveryId}}/status
Cookie: {{sellerCookie}}
Content-Type: {{contentType}}

{
  "status": "COLLECTED",
  "reason": "Collected by carrier"
}

###
# @name deliveryArrivedAtCenter
PATCH {{baseUrl}}/deliveries/{{deliveryId}}/status
Cookie: {{sellerCookie}}
Content-Type: {{contentType}}

{
  "status": "ARRIVED_AT_CENTER",
  "reason": "Arrived at distribution center"
}

###
# @name deliveryDelivered
PATCH {{baseUrl}}/deliveries/{{deliveryId}}/status
Cookie: {{sellerCookie}}
Content-Type: {{contentType}}

{
  "status": "DELIVERED",
  "reason": "Delivered to customer"
}

