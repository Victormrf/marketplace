@baseUrl = http://localhost:8000
@contentType = application/json
@page = 1
@limit = 20
@from = 2026-01-01
@to = 2026-12-31
@idempotencyKey = api-http-checkout-001

# PrÃƒÂ©-requisitos: PostgreSQL local disponÃƒÂ­vel, seed executado e backend rodando.
# VariÃƒÂ¡veis dinÃƒÂ¢micas sÃƒÂ³ existem depois da requisiÃƒÂ§ÃƒÂ£o que as produz ser executada.
# As variÃƒÂ¡veis seed_* sÃƒÂ£o determinÃƒÂ­sticas e servem como fallback para consultas.

###############################################################################
# SEEDED ACCOUNTS AND IDS
###############################################################################

@seedAdminUserId = 00000000-0000-0000-0000-000000000001
@seedCustomerUserId = 00000000-0000-0000-0000-000000000002
@seedSellerUserId = 00000000-0000-0000-0000-000000000003
@seedSecondSellerUserId = 00000000-0000-0000-0000-000000000004
@seedCustomerProfileId = 00000000-0000-0000-0000-000000000101
@seedAddressId = 00000000-0000-0000-0000-000000000201
@seedSellerId = 00000000-0000-0000-0000-000000000301
@seedSecondSellerId = 00000000-0000-0000-0000-000000000302
@seedProductId = 00000000-0000-0000-0000-000000000401
@seedSecondProductId = 00000000-0000-0000-0000-000000000402
@seedOrderId = 00000000-0000-0000-0000-000000000601
@seedSellerOrderId = 00000000-0000-0000-0000-000000000611
@seedOrderItemId = 00000000-0000-0000-0000-000000000621
@seedPaymentAttemptId = 00000000-0000-0000-0000-000000000701
@seedDeliveryId = 00000000-0000-0000-0000-000000000801
@seedProductReviewId = 00000000-0000-0000-0000-000000001001
@seedSellerReviewId = 00000000-0000-0000-0000-000000001002

###############################################################################
# AUTHENTICATION
############################################################################### Login independente do administrador; salva o JWT do cookie em cookie da resposta.
###
# @name adminLogin
POST {{baseUrl}}/users/login
Content-Type: {{contentType}}

{
  "email": "admin.seed@local.invalid",
  "password": "dev-seed-password"
}

### Login independente do seller principal; salva o JWT do cookie em cookie da resposta.
###
# @name sellerLogin
POST {{baseUrl}}/users/login
Content-Type: {{contentType}}

{
  "email": "seller.one.seed@local.invalid",
  "password": "dev-seed-password"
}

### Login independente do customer; salva o JWT do cookie em cookie da resposta.
###
# @name customerLogin
POST {{baseUrl}}/users/login
Content-Type: {{contentType}}

{
  "email": "customer.seed@local.invalid",
  "password": "dev-seed-password"
}

### Logout limpa o cookie HTTP-only, mas nÃƒÂ£o remove as variÃƒÂ¡veis globais salvas.
###
# @name adminLogout
# Logout do admin limpa o cookie no servidor; a response variable continua salva.
POST {{baseUrl}}/users/logout
Cookie: {{adminCookie}}

###
# @name sellerLogout
# Logout do seller limpa o cookie no servidor; a response variable continua salva.
POST {{baseUrl}}/users/logout
Cookie: {{sellerCookie}}

###
# @name customerLogout
# Logout do customer limpa o cookie no servidor; a response variable continua salva.
POST {{baseUrl}}/users/logout
Cookie: {{customerCookie}}

###
# Response variables de cookies. Execute o login correspondente antes dos endpoints da role.
###

@adminCookie = {{adminLogin.response.headers.Set-Cookie}}
@sellerCookie = {{sellerLogin.response.headers.Set-Cookie}}
@customerCookie = {{customerLogin.response.headers.Set-Cookie}}

###
###############################################################################
# ROOT
###############################################################################
###
# @name root
GET {{baseUrl}}/

###############################################################################
# USERS
############################################################################### Registro pÃƒÂºblico aceita somente CUSTOMER ou SELLER, nunca ADMIN.
###
# @name registerCustomer
POST {{baseUrl}}/users/register
Content-Type: {{contentType}}

{
  "name": "API HTTP Customer",
  "email": "api-http-customer-001@local.invalid",
  "password": "dev-api-password",
  "role": "CUSTOMER"
}

### ID dinÃƒÂ¢mico do usuÃƒÂ¡rio criado; a conta fica disponÃƒÂ­vel para fluxo manual.
###

@createdUserId = {{registerCustomer.response.body.$.id}}

### Identidade atual do administrador.
###
# @name adminMe
GET {{baseUrl}}/users/me
Cookie: {{adminCookie}}

### Identidade atual do seller.
###
# @name sellerMe
GET {{baseUrl}}/users/me
Cookie: {{sellerCookie}}

### Identidade atual do customer.
###
# @name customerMe
GET {{baseUrl}}/users/me
Cookie: {{customerCookie}}

### AtualizaÃƒÂ§ÃƒÂ£o whitelist do usuÃƒÂ¡rio autenticado.
###
# @name updateCurrentUser
PUT {{baseUrl}}/users
Cookie: {{customerCookie}}
Content-Type: {{contentType}}

{
  "name": "Seed Customer Updated Locally"
}

### DesativaÃƒÂ§ÃƒÂ£o administrativa de um usuÃƒÂ¡rio; deixar para execuÃƒÂ§ÃƒÂ£o manual.
###
# @name deactivateUser
DELETE {{baseUrl}}/users/{{createdUserId}}
Cookie: {{adminCookie}}

