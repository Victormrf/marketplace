###############################################################################
# INVENTORY
############################################################################### Consulta o inventÃƒÂ¡rio do produto recÃƒÂ©m-criado.
###
# @name getInventory
GET {{baseUrl}}/inventory/products/{{productId}}
Cookie: {{sellerCookie}}

### Consulta histÃƒÂ³rica paginada de movimentaÃƒÂ§ÃƒÂµes.
###
# @name listInventoryMovements
GET {{baseUrl}}/inventory/products/{{productId}}/movements?page={{page}}&limit={{limit}}
Cookie: {{sellerCookie}}

### Entrada de estoque em unidades inteiras.
###
