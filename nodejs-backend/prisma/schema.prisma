generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN

  @@map("user_role")
}

enum Currency {
  BRL
}

enum ProductCategory {
  OFFICE
  SPORTS
  BOOKS
  BEAUTY
  CLOTHING
  TOYS
  TV_PROJECTORS
  SMARTPHONES_TABLETS
  ELECTRONICS
  PETS
  FURNITURE

  @@map("category")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  PARTIALLY_COMPLETED
  COMPLETED
  CANCELLED
}

enum SellerOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PIX
  PAYPAL
}

enum PaymentAttemptStatus {
  CREATED
  PROCESSING
  AUTHORIZED
  CAPTURED
  FAILED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  DECLINED
  FAILED
}

enum InventoryMovementType {
  RESTOCK
  RESERVATION
  SALE_COMMIT
  RELEASE
  RETURN
  MANUAL_CORRECTION
}

enum InventoryReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
  CANCELLED
}

enum DeliveryStatus {
  SEPARATED
  PROCESSING
  SHIPPED
  COLLECTED
  ARRIVED_AT_CENTER
  DELIVERED
  FAILED
  RETURNED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String
  normalizedEmail String    @unique
  password        String
  role            UserRole
  isActive        Boolean   @default(true)
  deactivatedAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customerProfile CustomerProfile?
  seller          Seller?
  reviews         Review[]
  idempotencyKeys IdempotencyKey[]

  @@index([role, isActive])
  @@map("user")
}

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  addresses CustomerAddress[]
  carts     Cart[]
  orders    Order[]

  @@map("customer")
}

model CustomerAddress {
  id            String   @id @default(uuid())
  customerId    String
  recipientName String
  postalCode    String
  street        String
  number        String
  complement    String?
  neighborhood  String
  city          String
  state         String
  countryCode   String   @default("BR")
  phone         String?
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderAddresses OrderAddress[]

  @@index([customerId, isActive])
  @@index([customerId, isDefault])
  @@map("customer_address")
}

model Seller {
  id            String    @id @default(uuid())
  userId        String    @unique
  storeName     String
  logo          String?
  description   String?
  isActive      Boolean   @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  products     Product[]
  sellerOrders SellerOrder[]
  reviews      Review[]

  @@index([isActive, storeName])
  @@map("seller")
}

model Product {
  id            String          @id @default(uuid())
  sellerId      String
  name          String
  reference     String?
  description   String?
  priceInCents  Int
  currency      Currency        @default(BRL)
  category      ProductCategory
  image         String?
  isActive      Boolean         @default(true)
  deactivatedAt DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  seller     Seller      @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  inventory  Inventory?

  @@unique([sellerId, reference])
  @@index([sellerId, isActive, createdAt])
  @@index([category, isActive, createdAt])
  @@map("product")
}

model Inventory {
  id               String   @id @default(uuid())
  productId        String   @unique
  onHandQuantity   Int      @default(0)
  reservedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product      Product                @relation(fields: [productId], references: [id], onDelete: Restrict)
  movements    InventoryMovement[]
  reservations InventoryReservation[]

  @@map("inventory")
}

model InventoryReservation {
  id          String                     @id @default(uuid())
  inventoryId String
  orderItemId String                     @unique
  quantity    Int
  status      InventoryReservationStatus @default(ACTIVE)
  expiresAt   DateTime?
  committedAt DateTime?
  releasedAt  DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([inventoryId, status])
  @@index([status, expiresAt])
  @@map("inventory_reservation")
}

model InventoryMovement {
  id            String                @id @default(uuid())
  inventoryId   String
  orderItemId   String?
  movementType  InventoryMovementType
  onHandDelta   Int
  reservedDelta Int
  onHandAfter   Int
  reservedAfter Int
  reason        String?
  createdAt     DateTime              @default(now())

  inventory Inventory  @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@index([inventoryId, createdAt])
  @@index([orderItemId])
  @@map("inventory_movement")
}

model Cart {
  id          String     @id @default(uuid())
  customerId  String
  status      CartStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  convertedAt DateTime?
  abandonedAt DateTime?

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    CartItem[]

  @@index([customerId, status])
  @@map("cart")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([cartId, createdAt])
  @@map("cart_item")
}

model Order {
  id              String      @id @default(uuid())
  customerId      String
  status          OrderStatus @default(PENDING_PAYMENT)
  subtotalInCents Int
  shippingInCents Int         @default(0)
  taxInCents      Int         @default(0)
  discountInCents Int         @default(0)
  totalInCents    Int
  currency        Currency    @default(BRL)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  customer        CustomerProfile      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  address         OrderAddress?
  sellerOrders    SellerOrder[]
  paymentAttempts PaymentAttempt[]
  statusHistory   OrderStatusHistory[]
  idempotencyKeys IdempotencyKey[]

  @@index([customerId, createdAt])
  @@index([customerId, status, createdAt])
  @@map("order")
}

model SellerOrder {
  id              String            @id @default(uuid())
  orderId         String
  sellerId        String
  status          SellerOrderStatus @default(PENDING)
  subtotalInCents Int
  shippingInCents Int               @default(0)
  taxInCents      Int               @default(0)
  discountInCents Int               @default(0)
  totalInCents    Int
  currency        Currency
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  order         Order                      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller        Seller                     @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  delivery      Delivery?
  statusHistory SellerOrderStatusHistory[]

  @@unique([orderId, sellerId])
  @@index([sellerId, status, createdAt])
  @@index([orderId, createdAt])
  @@map("seller_order")
}

model OrderItem {
  id                       String   @id @default(uuid())
  sellerOrderId            String
  productId                String
  quantity                 Int
  unitPriceInCents         Int
  lineTotalInCents         Int
  currency                 Currency
  productNameSnapshot      String
  productReferenceSnapshot String?
  sellerNameSnapshot       String
  createdAt                DateTime @default(now())

  sellerOrder          SellerOrder           @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  product              Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  inventoryReservation InventoryReservation?
  inventoryMovements   InventoryMovement[]

  @@index([sellerOrderId])
  @@index([productId])
  @@map("order_item")
}

model OrderAddress {
  id              String   @id @default(uuid())
  orderId         String   @unique
  sourceAddressId String?
  recipientName   String
  postalCode      String
  street          String
  number          String
  complement      String?
  neighborhood    String
  city            String
  state           String
  countryCode     String
  phone           String?
  createdAt       DateTime @default(now())

  order         Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  sourceAddress CustomerAddress? @relation(fields: [sourceAddressId], references: [id], onDelete: SetNull)

  @@map("order_address")
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model SellerOrderStatusHistory {
  id            String             @id @default(uuid())
  sellerOrderId String
  fromStatus    SellerOrderStatus?
  toStatus      SellerOrderStatus
  reason        String?
  createdAt     DateTime           @default(now())

  sellerOrder SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)

  @@index([sellerOrderId, createdAt])
  @@map("seller_order_status_history")
}

model PaymentAttempt {
  id                String               @id @default(uuid())
  orderId           String
  provider          String
  providerReference String?
  method            PaymentMethod
  status            PaymentAttemptStatus @default(CREATED)
  amountInCents     Int
  currency          Currency
  failureCode       String?
  failureMessage    String?
  metadata          Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  authorizedAt      DateTime?
  capturedAt        DateTime?
  failedAt          DateTime?
  cancelledAt       DateTime?

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@unique([provider, providerReference])
  @@index([orderId, status, createdAt])
  @@map("payment_attempt")
}

model Refund {
  id                String       @id @default(uuid())
  paymentAttemptId  String
  amountInCents     Int
  currency          Currency
  reason            String?
  status            RefundStatus @default(REQUESTED)
  providerReference String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  completedAt       DateTime?
  failedAt          DateTime?

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  @@unique([paymentAttemptId, providerReference])
  @@index([paymentAttemptId, status, createdAt])
  @@map("refund")
}

model Delivery {
  id                String         @id @default(uuid())
  sellerOrderId     String         @unique
  trackingCode      String?
  carrier           String?
  status            DeliveryStatus @default(SEPARATED)
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  sellerOrder   SellerOrder             @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  statusHistory DeliveryStatusHistory[]

  @@index([status, updatedAt])
  @@index([trackingCode])
  @@map("delivery")
}

model DeliveryStatusHistory {
  id         String          @id @default(uuid())
  deliveryId String
  fromStatus DeliveryStatus?
  toStatus   DeliveryStatus
  changedAt  DateTime        @default(now())
  reason     String?

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  @@index([deliveryId, changedAt])
  @@map("delivery_status_history")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String?
  sellerId  String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller  Seller?  @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([userId, productId])
  @@unique([userId, sellerId])
  @@index([productId, createdAt])
  @@index([sellerId, createdAt])
  @@map("review")
}

model IdempotencyKey {
  id                 String            @id @default(uuid())
  userId             String
  orderId            String?
  operation          String
  key                String
  requestFingerprint String
  status             IdempotencyStatus @default(PROCESSING)
  result             Json?
  expiresAt          DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  completedAt        DateTime?

  user  User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  order Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([userId, operation, key])
  @@index([operation, status, expiresAt])
  @@index([orderId])
  @@map("idempotency_key")
}
