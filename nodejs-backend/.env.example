DATABASE_URL=postgresql://marketplace_dev:marketplace_dev_password@localhost:5433/marketplace_dev
# Local only; never publish /metrics through an external proxy.
METRICS_ENABLED=false
METRICS_DB_INTERVAL_MS=30000
METRICS_DB_TIMEOUT_MS=2000
# Optional local traces, starting at Express; not Next/BFF.
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
# Private Prometheus exception: exact source IP AND secret required.
# Paths are resolved from the backend working directory.
METRICS_REMOTE_ADDRESSES=
METRICS_REMOTE_TOKEN_FILE=
# Explicit, optional delivery queue; not started by the API.
DELIVERY_REDIS_URL=redis://127.0.0.1:6381/0
DELIVERY_QUEUE_PREFIX=marketplace-delivery
DELIVERY_WORKER_CONCURRENCY=1
# Optional explicit scheduler registration; minimum 60000, maximum 86400000.
DELIVERY_DISCOVERY_INTERVAL_MS=300000
